# Dependencies and build output. Safe to delete; npm install and npm run build recreate them.
node_modules/
dist/

# Astro generates types here when you run dev or build.
.astro/

# Local environment files, if you add them later.
.env
.env.*

# Python virtualenvs, including the clinic-finder example.
.venv/

# Vercel CLI metadata.
.vercel/

# Logs and OS junk.
npm-debug.log*
.DS_Store
*.tsbuildinfo

# JSON written by airflow/dags/build_notebook_index.py. Not used by the site.
airflow/output/
