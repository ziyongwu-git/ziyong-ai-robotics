# Dependencies and build output. Safe to delete; npm install and npm run build recreate them.
node_modules/
dist/

# Astro generates types here when you run dev or build.
.astro/

# Local environment files. .env.example is the blank template and is committed.
.env
.env.*
!.env.example

# Python virtualenvs and bytecode, including the clinic-finder example.
.venv/
__pycache__/
*.pyc

# Vercel CLI metadata.
.vercel/

# Logs and OS junk.
npm-debug.log*
.DS_Store
*.tsbuildinfo

# JSON written by airflow/dags/build_notebook_index.py. Not used by the site.
airflow/output/
