# Copy this file to .env for local work.
# .env is not uploaded to GitHub. Do not put a real invite code in this example file.

# Comma-separated codes. Leave this empty to keep demos and builds locked.
# Codes are case-sensitive. Do not put a comma inside a code.
INVITE_CODES=

# At least 16 random characters. This signs the unlock cookie.
# Make one with: openssl rand -base64 32
INVITE_COOKIE_SECRET=

# Set to 1 to skip the gate while you run `npm run dev`.
# This does nothing on Vercel, and nothing in `npm run build`.
INVITE_DEV_UNLOCK=
