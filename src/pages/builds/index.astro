---
import Band from '../../components/Band.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuildCard from '../../components/BuildCard.astro';
import { getBuilds } from '../../lib/content';

const builds = await getBuilds();
---

<BaseLayout
  title="Builds"
  description="Products Ziyong Wu has shipped. Each page is one product, with the live app when it is up."
>
  <header class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="max-w-[65ch]">
      <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Shipped</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Builds</h1>
      <p class="mt-4 text-lg leading-8 text-muted">
        Products I have shipped. The date on each one is the last time I updated the page. A live link is there when
        the app is up.
      </p>
    </div>
    <Band kind="builds" />
  </header>
  <div class="mt-10">
    {
      builds.length === 0 ? (
        <p class="text-muted">No builds yet.</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {builds.map((build) => (
            <BuildCard build={build} layout={builds.length === 1 ? 'feature' : 'card'} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
