---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import { site } from '../config';
---

<BaseLayout
  title="About"
  description="Bio for Ziyong Wu, a data engineer with about ten years at Meta, moving into AI and robotics."
  width="narrow"
>
  <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Bio</p>
  <h1 class="mt-3 font-serif text-4xl sm:text-5xl">About</h1>
  <p class="mt-4 text-lg leading-8 text-muted">
    A short resume page. The Meta role below is filled in. Boxes marked Placeholder are waiting for your own words.
  </p>

  <section class="mt-10" aria-labelledby="bio-heading">
    <h2 id="bio-heading" class="font-serif text-3xl">Summary</h2>
    <p class="mt-4 leading-7">
      I am a data engineer moving into AI and robotics. I spent about ten years at Meta as a Staff/Senior Data Engineer.
      Data is the strength I am building the next chapter on.
    </p>
    <div class="mt-4">
      <PlaceholderNote>
        Add a few sentences in your own words: the kind of data work you want a hiring manager to remember, and what you
        want next in AI or robotics. Write the details yourself so the page stays accurate.
      </PlaceholderNote>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="font-serif text-3xl">Experience</h2>
    <article class="mt-4 rounded-2xl border border-line bg-card p-5">
      <p class="font-mono text-xs tracking-[0.16em] text-highlight uppercase">Confirmed</p>
      <h3 class="mt-2 font-serif text-2xl">Meta</h3>
      <p class="mt-1">Staff / Senior Data Engineer</p>
      <p class="text-sm text-muted">About 10 years</p>
      <div class="mt-4">
        <PlaceholderNote>
          Add a short description of the work you want a hiring manager to know. Add project names and numbers yourself
          when you are ready to publish them.
        </PlaceholderNote>
      </div>
    </article>
  </section>

  <section class="mt-12" aria-labelledby="education-heading">
    <h2 id="education-heading" class="font-serif text-3xl">Education</h2>
    <div class="mt-4">
      <PlaceholderNote>
        Add schools, degrees, and dates when you want them listed. They are left blank on purpose.
      </PlaceholderNote>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="font-serif text-3xl">Contact</h2>
    <p class="mt-4 text-sm leading-6 text-muted">
      Email and GitHub are live. LinkedIn still needs your real profile URL.
    </p>
    <ul class="mt-4 divide-y divide-line border-y border-line">
      <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
        <div>
          <p class="font-mono text-xs tracking-[0.16em] text-muted uppercase">Email</p>
          <a class="mt-1 inline-block text-lg text-accent" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </li>
      <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
        <div>
          <p class="font-mono text-xs tracking-[0.16em] text-muted uppercase">LinkedIn</p>
          <a class="mt-1 inline-block text-lg text-accent" href={site.linkedin}>{site.linkedin.replace('https://', '')}</a>
          <p class="text-sm text-muted">{site.linkedinNote}</p>
        </div>
      </li>
      <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
        <div>
          <p class="font-mono text-xs tracking-[0.16em] text-muted uppercase">GitHub</p>
          <a class="mt-1 inline-block text-lg text-accent" href={site.github} target="_blank" rel="noopener noreferrer">
            {site.github.replace('https://', '')}
          </a>
        </div>
      </li>
    </ul>
  </section>

  <p class="mt-10 text-sm text-muted">
    <a class="text-accent underline decoration-line underline-offset-4" href="/learning">Learning log</a>
    <span aria-hidden="true"> · </span>
    <a class="text-accent underline decoration-line underline-offset-4" href="/projects">Projects</a>
  </p>
</BaseLayout>
