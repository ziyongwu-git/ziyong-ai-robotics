---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That address is not on this site." noindex>
  <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">404</p>
  <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Page not found</h1>
  <p class="mt-4 max-w-xl text-lg leading-8 text-muted">That address is not on this site.</p>
  <p class="mt-8">
    <a
      class="inline-flex rounded-full bg-ink px-4 py-2 text-sm text-paper hover:bg-accent"
      href="/"
    >
      Back to the home page
    </a>
  </p>
</BaseLayout>
