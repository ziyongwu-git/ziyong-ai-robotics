---
import Band from '../../components/Band.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LearningCard from '../../components/LearningCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getLearningPosts, isSampleNote } from '../../lib/content';

const posts = await getLearningPosts();
const notes = posts.filter((post) => !isSampleNote(post));
const samples = posts.filter((post) => isSampleNote(post));
---

<BaseLayout
  title="Notes"
  description="Notes from Ziyong Wu on AI, robotics, and data. Newest first. Each note names the DeepLearning.AI certificate it is built on."
>
  <header class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="max-w-[65ch]">
      <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Learning</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Notes</h1>
      <p class="mt-4 text-lg leading-8 text-muted">
        Explainers I want to be able to re-read. Newest first. Each one names its sources and the certificate it is
        built on, and points at a demo when there is one.
      </p>
      <p class="mt-4">
        <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/certificates">Certificates</a>
      </p>
    </div>
    <Band kind="learning" />
  </header>
  <div class="mt-10">
    {
      notes.length === 0 ? (
        <p class="text-muted">No notes yet.</p>
      ) : (
        <TagFilter>
          {notes.map((post) => (
            <LearningCard post={post} />
          ))}
        </TagFilter>
      )
    }
  </div>

  {
    samples.length > 0 && (
      <section class="mt-16" id="samples" aria-labelledby="sample-notes">
        <h2 id="sample-notes" class="font-serif text-3xl">Sample archive</h2>
        <p class="mt-2 max-w-[65ch] text-sm leading-6 text-muted">
          Format examples. Copy one when you start a note. The addresses stay so older links still open.
        </p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {samples.map((post) => (
            <LearningCard post={post} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
