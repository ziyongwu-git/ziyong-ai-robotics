---
import Band from '../../components/Band.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LearningCard from '../../components/LearningCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getLearningPosts } from '../../lib/content';

const posts = await getLearningPosts();
---

<BaseLayout
  title="Notes"
  description="Course notes from Ziyong Wu on AI, robotics, and data. Newest first. Each note names the DeepLearning.AI certificate it is built on."
>
  <header class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="max-w-2xl">
      <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Learning</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Notes</h1>
      <p class="mt-4 text-lg leading-8 text-muted">
        Notes from courses, papers, and practice. Newest first. Filter by AI, robotics, or data. Each note links to the
        certificate it is built on, and to any demo that uses the same one.
      </p>
      <p class="mt-4">
        <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/certificates">Certificates</a>
      </p>
    </div>
    <Band kind="learning" />
  </header>
  <div class="mt-10">
    {
      posts.length === 0 ? (
        <p class="text-muted">No notes yet.</p>
      ) : (
        <TagFilter>
          {posts.map((post) => (
            <LearningCard post={post} />
          ))}
        </TagFilter>
      )
    }
  </div>
</BaseLayout>
