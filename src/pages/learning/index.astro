---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LearningCard from '../../components/LearningCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getLearningPosts } from '../../lib/content';

const posts = await getLearningPosts();
---

<BaseLayout
  title="Learning log"
  description="Course notes and daily writing from Ziyong Wu on AI, robotics, and data. Newest first."
>
  <header class="max-w-2xl">
    <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Notes</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">Learning log</h1>
    <p class="mt-4 text-lg leading-8 text-muted">
      Notes from courses, papers, and practice. Newest first. Filter by AI, robotics, or data.
    </p>
  </header>
  <div class="mt-10">
    {
      posts.length === 0 ? (
        <p class="text-muted">No notes yet.</p>
      ) : (
        <TagFilter>
          {posts.map((post) => (
            <LearningCard post={post} />
          ))}
        </TagFilter>
      )
    }
  </div>
</BaseLayout>
