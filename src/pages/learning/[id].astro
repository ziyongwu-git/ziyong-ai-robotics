---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, isoDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('learning');
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
if (!id) {
  throw new Error('Missing learning log id.');
}

const post = await getEntry('learning', id);
if (!post) {
  throw new Error(`No learning log entry for ${id}.`);
}

const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  width="narrow"
  ogType="article"
  published={post.data.date}
>
  <p>
    <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/learning">All notes</a>
  </p>
  <p class="mt-6 text-sm text-muted">
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
  </p>
  <div class="mt-3">
    <TagList tags={post.data.tags} filterHref="/learning" />
  </div>
  <h1 class="mt-4 font-serif text-4xl leading-tight sm:text-5xl">{post.data.title}</h1>
  <p class="mt-4 text-lg leading-8 text-muted">{post.data.summary}</p>
  <p class="mt-4 text-sm">
    <span class="font-mono text-xs tracking-wide text-muted uppercase">Course / source</span>
    <span class="text-muted"> · </span>
    {post.data.source}
  </p>
  <div class="prose mt-10 max-w-none">
    <Content />
  </div>
</BaseLayout>
