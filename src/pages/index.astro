---
import BaseLayout from '../layouts/BaseLayout.astro';
import Certifications from '../components/Certifications.astro';
import HeroFigure from '../components/HeroFigure.astro';
import LearningCard from '../components/LearningCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config';
import { getFeaturedProjects, getLearningPosts } from '../lib/content';
import { locationLabel } from '../profile';

const posts = (await getLearningPosts()).slice(0, 3);
const featured = await getFeaturedProjects();
---

<BaseLayout title={site.name} description={site.description}>
  <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(280px,0.95fr)]">
    <div class="enter">
      <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Public notebook</p>
      <h1 class="mt-3 font-serif text-5xl text-ink sm:text-7xl">{site.name}</h1>
      <p class="mt-4 max-w-xl font-serif text-2xl italic leading-snug text-ink sm:text-3xl">
        Notes on data, models, and machines that move.
      </p>
      <div class="mt-6 max-w-xl space-y-4 text-base leading-7 text-muted">
        <p>
          This is my public notebook for a move from data engineering into AI and robotics. Course notes, small
          experiments, and tools you can click. Pages marked Sample show the format.
        </p>
        <p>
          The notes grow out of work already on the record: Ray-Ban Stories telemetry, an XR-input measurement stack,
          an accuracy metric for a company AI system, and large-scale advertising data.
        </p>
      </div>
      <p class="mt-6 max-w-xl text-sm leading-6 text-muted">
        {locationLabel}. Meta, 2019–July 2026. Munich Re, 2016–2019.{' '}
        <a class="text-accent underline decoration-line underline-offset-4" href="/about">About the work</a>
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-solid" href="/learning">Read the notes</a>
        <a class="btn btn-line" href="/projects">See projects</a>
      </div>
    </div>
    <HeroFigure />
  </section>

  <div class="mt-14">
    <Certifications variant="strip" />
  </div>

  <section class="mt-14" aria-labelledby="notes-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="notes-heading" class="font-serif text-3xl">From the log</h2>
      <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/learning">All notes</a>
    </div>
    {
      posts.length === 0 ? (
        <p class="mt-6 text-muted">No notes yet. New files in src/content/learning/ show up here.</p>
      ) : (
        <div class="mt-6 space-y-5">
          {posts.map((post, index) => (
            <LearningCard post={post} layout={index === 0 ? 'feature' : 'row'} />
          ))}
        </div>
      )
    }
  </section>

  <section class="mt-16" aria-labelledby="featured-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="featured-heading" class="font-serif text-3xl">On the bench</h2>
      <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/projects">All projects</a>
    </div>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">
      Small tools and experiments. A project can be a write-up, or a page with something you can move.
    </p>
    {
      featured.length === 0 ? (
        <p class="mt-6 text-muted">No featured projects yet. Set featured: true on a project to show it here.</p>
      ) : (
        <div class="mt-6 space-y-5">
          {featured.map((project, index) => (
            <ProjectCard project={project} layout={index === 0 ? 'feature' : 'row'} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
