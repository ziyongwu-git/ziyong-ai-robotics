---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuiltOn from '../components/BuiltOn.astro';
import CertCard from '../components/CertCard.astro';
import HeroFigure from '../components/HeroFigure.astro';
import LearningCard from '../components/LearningCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TabletopVla from '../components/demos/TabletopVla.tsx';
import { site } from '../config';
import { getFeaturedProjects, getLearningPosts, getProjects, workCounts } from '../lib/content';
import { certsFor, currentlyLearning } from '../lib/certifications';

const posts = (await getLearningPosts()).slice(0, 3);
const featured = await getFeaturedProjects();
const gallery = featured.length > 0 ? featured : await getProjects();
const stage = gallery.find((item) => item.id === 'see-think-move');
const homeCerts = currentlyLearning();
const certCounts = await Promise.all(homeCerts.map(async (cert) => ({ cert, ...(await workCounts(cert.id)) })));
---

<BaseLayout title={site.name} description={site.description}>
  <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(280px,0.95fr)]">
    <div class="enter">
      <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Public notebook</p>
      <h1 class="mt-3 font-serif text-5xl text-ink sm:text-7xl">{site.name}</h1>
      <p class="mt-4 max-w-xl font-serif text-2xl italic leading-snug text-ink sm:text-3xl">
        Demos you can poke, notes worth keeping, certificates they sit on.
      </p>
      <p class="mt-6 max-w-xl text-base leading-7 text-muted">
        A public notebook about AI, data, and machines that move. Start with something you can click. Pages marked
        Sample show the format.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-solid" href="#demos">Play a demo</a>
        <a class="btn btn-line" href="/learning">Read the notes</a>
      </div>
    </div>
    <HeroFigure />
  </section>

  {
    stage && (
      <section class="enter-late mt-14 scroll-mt-24" id="demos" aria-labelledby="stage-heading">
        <div class="overflow-hidden rounded-[2rem] border border-line bg-card">
          <div class="flex flex-wrap items-end justify-between gap-4 p-5 sm:p-7">
            <div class="max-w-2xl">
              <p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Live demo</p>
              <h2 id="stage-heading" class="mt-2 font-serif text-4xl">
                <a class="hover:text-accent" href={`/demos/${stage.id}`}>
                  {stage.data.title}
                </a>
              </h2>
              <p class="mt-3 text-base leading-7 text-muted">{stage.data.summary}</p>
            </div>
            <BuiltOn certs={certsFor(stage.data.certification)} layout="compact" />
          </div>
          <div class="px-3 pb-4 sm:px-5 sm:pb-6">
            <TabletopVla client:load />
          </div>
        </div>
      </section>
    )
  }

  <section class:list={['mt-14', !stage && 'scroll-mt-24']} aria-labelledby="gallery-heading" id={stage ? undefined : 'demos'}>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="gallery-heading" class="font-serif text-3xl">Demos</h2>
      <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/demos">All demos</a>
    </div>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">
      Small experiments you can move. Swipe the row, or open a card.
    </p>
    {
      gallery.length === 0 ? (
        <p class="mt-6 text-muted">No demos yet. New files in src/content/projects/ show up here.</p>
      ) : (
        <div class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0">
          {gallery.map((project) => (
            <div class="w-[85%] shrink-0 snap-start sm:w-[22rem] lg:w-full lg:shrink">
              <ProjectCard project={project} layout="card" />
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section class="mt-16" aria-labelledby="notes-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="notes-heading" class="font-serif text-3xl">Notes</h2>
      <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/learning">All notes</a>
    </div>
    {
      posts.length === 0 ? (
        <p class="mt-6 text-muted">No notes yet. New files in src/content/learning/ show up here.</p>
      ) : (
        <div class="mt-6 space-y-5">
          {posts.map((post, index) => (
            <LearningCard post={post} layout={index === 0 ? 'feature' : 'row'} />
          ))}
        </div>
      )
    }
  </section>

  <section class="mt-16" aria-labelledby="certs-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="certs-heading" class="font-serif text-3xl">Certificates</h2>
      <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/certificates">
        All certificates
      </a>
    </div>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">
      DeepLearning.AI certificates the demos and notes are built on. Each card opens the certificate and the work that uses it.
    </p>
    {
      certCounts.length === 0 ? (
        <p class="mt-6 text-muted">No DeepLearning.AI certificates are marked for the home row yet.</p>
      ) : (
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {certCounts.map(({ cert, demos, notes }) => (
            <CertCard cert={cert} demos={demos} notes={notes} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
