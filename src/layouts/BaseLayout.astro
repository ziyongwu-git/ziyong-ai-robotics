---
import '../styles/global.css';
import { site } from '../config';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  /** Browser-tab title. The site name is added for you, except on the home page. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** Narrow column for a single note. Wide for the home page and the indexes. */
  width?: 'wide' | 'narrow';
  /** Use "article" on a single note or project. */
  ogType?: 'website' | 'article';
  /** Publish date for a note or project, when it has one. */
  published?: Date;
  /** The 404 page sets this so search engines skip it. */
  noindex?: boolean;
}

const {
  title,
  description,
  width = 'wide',
  ogType = 'website',
  published,
  noindex = false,
} = Astro.props;

const fullTitle = title === site.name ? `${site.name} — ${site.role}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssHref = new URL('rss.xml', Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: site.role,
  jobTitle: 'Data Engineer',
  url: Astro.site?.href,
  sameAs: [site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Runs before first paint so the saved theme does not flash.
      The button in the header is what a visitor actually clicks.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = stored === 'dark' || (stored !== 'light' && prefersDark);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (error) {
          /* Storage can be blocked. The light theme still works. */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Learning log`} href={rssHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <a
      href="#main"
      class="absolute left-4 top-[-4rem] z-50 rounded-full bg-ink px-4 py-2 text-sm text-paper focus:top-4"
    >
      Skip to content
    </a>
    <div class="h-1 bg-accent" aria-hidden="true"></div>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class:list={[
        'mx-auto w-full flex-1 px-5 py-12 outline-none sm:px-8 sm:py-16',
        width === 'narrow' ? 'max-w-3xl' : 'max-w-6xl',
      ]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
