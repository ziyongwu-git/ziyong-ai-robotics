---
import { nav, site } from '../config';

const currentPath = normalize(Astro.url.pathname);

function normalize(path: string): string {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
}

function isActive(href: string): boolean {
  const target = normalize(href);
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
}
---

<header class="sticky top-0 z-20 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-5 py-3 sm:px-8">
    <a href="/" class="flex items-center gap-2 text-ink">
      <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
        <path
          d="M4 26 14 8 28 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <circle cx="4" cy="26" r="2.2" fill="currentColor"></circle>
        <circle cx="14" cy="8" r="2.2" fill="currentColor"></circle>
        <circle cx="28" cy="16" r="2.4" fill="var(--highlight)"></circle>
      </svg>
      <span class="font-medium tracking-tight">{site.name}</span>
    </a>
    <div class="flex items-center gap-1">
      <nav aria-label="Primary" class="flex flex-wrap items-center gap-1">
        {
          nav.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'rounded-full px-2.5 py-2 text-sm whitespace-nowrap',
                  active ? 'bg-ink text-paper' : 'text-ink hover:bg-accent-soft',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink"
        aria-label="Switch to dark theme"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 dark:hidden" aria-hidden="true">
          <path fill="currentColor" d="M14.5 2.4a8.2 8.2 0 1 0 7.1 12.3A7.1 7.1 0 0 1 14.5 2.4z"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden h-5 w-5 dark:block" aria-hidden="true">
          <circle cx="12" cy="12" r="3.4" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"></path>
          </g>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function apply(dark: boolean, persist: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    if (persist) {
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* The theme still changes for this visit when storage is blocked. */
      }
    }
    button?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  }

  apply(document.documentElement.classList.contains('dark'), false);

  button?.addEventListener('click', () => {
    apply(!document.documentElement.classList.contains('dark'), true);
  });

  media.addEventListener('change', (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      stored = null;
    }
    if (stored) return;
    apply(event.matches, false);
  });
</script>
