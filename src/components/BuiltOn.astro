---
/**
 * Quiet certificate line for a demo or a note.
 *
 * The name goes to the page on this site. "Credential" opens the
 * DeepLearning.AI page in a new tab.
 */
import type { Certification } from '../data/certifications';

interface Props {
  certs: readonly Certification[];
  layout?: 'card' | 'compact';
}

const { certs, layout = 'card' } = Astro.props;
---

{
  certs.length > 0 && (
    <div class:list={[layout === 'card' && 'rounded-2xl border border-line bg-card px-4 py-3']} aria-label="Built on">
      <ul class="space-y-2">
        {certs.map((cert) => (
          <li class="text-sm leading-6 text-muted">
            <span class="text-ink">Built on </span>
            <a class="font-medium text-ink underline decoration-line underline-offset-4 hover:text-accent" href={`/certificates/${cert.id}`}>
              {cert.name}
            </a>
            <span>
              {' '}
              · {cert.issuer} · {cert.date}
            </span>
            {cert.credentialUrl && (
              <>
                <span> · </span>
                <a
                  class="text-accent underline decoration-line underline-offset-4"
                  href={cert.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Credential
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}
