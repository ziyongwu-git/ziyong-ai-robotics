---
/**
 * A short drawing for the top of an index page.
 * Decorative. The page heading is the accessible name.
 */
interface Props {
  kind: 'learning' | 'projects' | 'certifications';
}

const { kind } = Astro.props;
---

<div class="overflow-hidden rounded-3xl border border-line bg-card" aria-hidden="true">
  <svg viewBox="0 0 640 132" class="h-auto w-full">
    <defs>
      <pattern id={`band-${kind}`} width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="var(--line)"></circle>
      </pattern>
    </defs>
    <rect width="640" height="132" fill={`url(#band-${kind})`}></rect>
    {
      kind === 'learning' && (
        <g>
          <path
            d="M-10 46 C 120 46, 180 78, 300 70 S 480 40, 660 62"
            fill="none"
            stroke="var(--highlight)"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-dasharray="1.5 8"
          />
          <path
            d="M-10 86 C 140 96, 240 58, 380 84 S 520 108, 660 78"
            fill="none"
            stroke="var(--accent)"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-dasharray="1.5 8"
          />
          <g fill="var(--card)" stroke="var(--ink)" stroke-width="1.5">
            <circle cx="120" cy="58" r="5" />
            <circle cx="210" cy="74" r="5" />
            <circle cx="300" cy="52" r="6" fill="var(--highlight)" stroke="none" />
            <circle cx="390" cy="80" r="5" />
            <circle cx="490" cy="60" r="5" />
          </g>
          <g stroke="var(--ink)" stroke-opacity="0.35">
            <line x1="120" y1="58" x2="210" y2="74" />
            <line x1="210" y1="74" x2="300" y2="52" />
            <line x1="300" y1="52" x2="390" y2="80" />
            <line x1="390" y1="80" x2="490" y2="60" />
          </g>
        </g>
      )
    }
    {
      kind === 'projects' && (
        <g>
          <path d="M90 40 H150 M90 66 H150 M90 92 H150" stroke="var(--highlight)" stroke-width="1.6" stroke-linecap="round" />
          <path d="M150 66 H210" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
          <path d="M270 48 H330 M270 84 H330" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" />
          <path d="M210 66 C 230 66, 240 48, 270 48" fill="none" stroke="var(--accent)" stroke-width="1.6" />
          <path d="M210 66 C 230 66, 240 84, 270 84" fill="none" stroke="var(--highlight)" stroke-width="1.6" />
          <rect x="40" y="26" width="50" height="18" rx="6" fill="var(--card)" stroke="var(--ink)" />
          <rect x="40" y="56" width="50" height="18" rx="6" fill="var(--card)" stroke="var(--ink)" />
          <rect x="40" y="82" width="50" height="18" rx="6" fill="var(--card)" stroke="var(--ink)" />
          <rect x="210" y="54" width="58" height="24" rx="8" fill="var(--highlight-soft)" stroke="var(--highlight)" />
          <rect x="330" y="36" width="54" height="22" rx="8" fill="var(--card)" stroke="var(--accent)" />
          <rect x="330" y="74" width="54" height="22" rx="8" fill="var(--card)" stroke="var(--highlight)" />
          <rect x="430" y="48" width="28" height="18" rx="6" fill="var(--accent)" />
          <rect x="500" y="40" width="70" height="36" rx="10" fill="var(--card)" stroke="var(--ink)" />
          <rect x="590" y="40" width="36" height="36" rx="18" fill="var(--ink)" />
        </g>
      )
    }
    {
      kind === 'certifications' && (
        <g>
          <path
            d="M40 78 H 600"
            fill="none"
            stroke="var(--line)"
            stroke-width="2"
            stroke-dasharray="2 8"
          />
          <g>
            <circle cx="80" cy="78" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="1.6" />
            <circle cx="180" cy="78" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="1.6" />
            <circle cx="280" cy="78" r="6" fill="var(--card)" stroke="var(--accent)" stroke-width="1.6" />
            <circle cx="380" cy="78" r="7" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.6" />
            <circle cx="480" cy="78" r="8" fill="var(--highlight)" />
            <circle cx="580" cy="78" r="5" fill="var(--card)" stroke="var(--ink)" stroke-width="1.6" />
          </g>
        </g>
      )
    }
  </svg>
</div>
