---
/**
 * Certifications and courses, from src/data/certifications.ts.
 *
 * strip: the home-page "Currently learning" band (recent certificates only).
 * rail: the same recent list, stacked, for the learning-log sidebar.
 * full: every certificate, grouped, for /learning/certifications.
 *
 * Nested courses render under their parent. They are not repeated in the
 * top-level list, and they are not put on the home strip.
 */
import CertRow from './CertRow.astro';
import type { Certification } from '../data/certifications';
import { certificationsInGroup, coursesUnder, currentlyLearning } from '../lib/certifications';

interface Props {
  variant: 'strip' | 'rail' | 'full';
}

const { variant } = Astro.props;
const current = currentlyLearning();
const ai = certificationsInGroup('ai');
const earlier = certificationsInGroup('earlier');

function meta(item: Certification): string {
  return `${item.issuer} · ${item.date}`;
}
---

{
  variant === 'strip' && (
    <section class="rounded-3xl border border-line bg-card px-5 py-5 sm:px-6" aria-labelledby="currently-learning">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 64 28" class="hidden h-7 w-16 text-highlight sm:block" aria-hidden="true">
            <path d="M2 20 C 16 20, 18 8, 32 8 S 48 20, 62 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="1.2 4" />
            <circle cx="14" cy="18" r="2.2" fill="currentColor" />
            <circle cx="32" cy="8" r="2.6" fill="var(--accent)" />
            <circle cx="50" cy="16" r="2.2" fill="currentColor" />
          </svg>
          <div>
            <h2 id="currently-learning" class="font-serif text-2xl">
              Currently learning
            </h2>
            <p class="mt-1 text-sm text-muted">Recent certificates, newest first. A title opens the credential.</p>
          </div>
        </div>
        <a class="text-sm text-accent underline decoration-line underline-offset-4" href="/learning/certifications">
          All certifications
        </a>
      </div>
      {current.length === 0 ? (
        <p class="mt-4 text-sm text-muted">
          Nothing is marked current in src/data/certifications.ts yet.
        </p>
      ) : (
        <ul class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          {current.map((item) => (
            <li>
              {item.credentialUrl ? (
                <a class="group block rounded-lg" href={item.credentialUrl} target="_blank" rel="noopener noreferrer">
                  <span class="font-medium text-ink group-hover:text-accent">{item.name}</span>
                  <span class="sr-only"> (credential, opens in a new tab)</span>
                  <span class="mt-1 block font-mono text-xs tracking-wide text-muted uppercase">{meta(item)}</span>
                </a>
              ) : (
                <p>
                  <span class="font-medium">{item.name}</span>
                  <span class="mt-1 block font-mono text-xs tracking-wide text-muted uppercase">{meta(item)}</span>
                </p>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

{
  variant === 'rail' && (
    <aside class="rounded-3xl border border-line bg-card p-5" aria-labelledby="learning-current">
      <h2 id="learning-current" class="font-serif text-2xl">
        Currently learning
      </h2>
      {current.length === 0 ? (
        <p class="mt-3 text-sm text-muted">Recent certificates will show up here.</p>
      ) : (
        <ol class="mt-4 space-y-3">
          {current.map((item) => (
            <li>
              {item.credentialUrl ? (
                <a
                  class="text-sm font-medium text-ink underline decoration-line underline-offset-4 hover:text-accent"
                  href={item.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.name}
                  <span class="sr-only"> (credential, opens in a new tab)</span>
                </a>
              ) : (
                <p class="text-sm font-medium">{item.name}</p>
              )}
              <p class="mt-0.5 font-mono text-[0.7rem] tracking-wide text-muted uppercase">{meta(item)}</p>
            </li>
          ))}
        </ol>
      )}
      <a class="mt-4 inline-block text-sm text-accent underline decoration-line underline-offset-4" href="/learning/certifications">
        All certifications
      </a>
    </aside>
  )
}

{
  variant === 'full' && (
    <div class="space-y-12">
      <section aria-labelledby="ai-certs">
        <h2 id="ai-certs" class="font-serif text-3xl">
          AI &amp; machine learning (2026)
        </h2>
        <ol class="mt-4 divide-y divide-line border-y border-line">
          {ai.map((item) => {
            const courses = coursesUnder(item.id);
            return (
              <li class="py-4">
                <CertRow item={item} />
                {courses.length > 0 && (
                  <div class="mt-3 border-l border-line pl-4">
                    <p class="font-mono text-xs tracking-[0.14em] text-muted uppercase">Courses</p>
                    <ul class="mt-2 space-y-3">
                      {courses.map((course) => (
                        <li>
                          <CertRow item={course} nested />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </section>
      <section aria-labelledby="earlier-certs">
        <h2 id="earlier-certs" class="font-serif text-3xl">
          Data, cloud &amp; earlier
        </h2>
        <ol class="mt-4 divide-y divide-line border-y border-line">
          {earlier.map((item) => (
            <li class="py-4">
              <CertRow item={item} />
            </li>
          ))}
        </ol>
      </section>
    </div>
  )
}
